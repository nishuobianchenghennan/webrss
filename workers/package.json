{
  "name": "@rss-plus/workers",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply rss-reader-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply rss-reader-db --remote"
  },
  "dependencies": {
    "hono": "^4.4.0",
    "@rss-plus/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "typescript": "^5.4.0",
    "wrangler": "^3.60.0"
  }
}
